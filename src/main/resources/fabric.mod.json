{
	"schemaVersion": 1,
	"id": "waterscary",
	"version": "${version}",
	"name": "WaterScary",
	"description": "A simple mod that adds visual damage while in the water. The sound is also played at the level. The longer you are in the water, the more often shaking.",
	"authors": [
		"mr_GrANTt"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/mrGrANTt/WaterScary/"
	},
	"license": "CC0-1.0",
	"icon": "assets/waterscary/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mrg.WaterScary"
		],
		"client": [
			"com.mrg.WaterScaryClient"
		],
		"modmenu": [
			"com.mrg.ModeMenuApi"
		]
	},
	"mixins": [
		"waterscary.mixins.json",
		{
			"config": "waterscary.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.11",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/wather-scary"
			},
			"update_checker": true
		}
	}
}